## Simulation loop

time = 0

previous_ground_speed = 0
previous_angular_velocity = 0

# Initialize lists to store data points
time_points = []
angular_velocities = []

while time <= duration:
  ground_speed = get_ground_speed(time)
  ground_acceleration = ground_speed - previous_ground_speed

  ideal_angular_velocity = ground_speed / r # velocity if wheel and ground matched speeds
  ideal_angular_acceleration = (ideal_angular_velocity - previous_angular_velocity) / step

  ideal_torque = I * ideal_angular_acceleration
  ideal_applied_force = ideal_torque / r

  actual_applied_force = ideal_applied_force if ideal_applied_force < max_static_friction else dynamic_friction
  actual_torque = actual_applied_force * r

  angular_acceleration = actual_torque / I
  angular_velocity = previous_angular_velocity + angular_acceleration * step

  # Append data to lists
  time_points.append(time)
  angular_velocities.append(angular_velocity)

  previous_ground_speed = ground_speed
  previous_angular_velocity = angular_velocity

  time += step

# After the loop, update the plot with all collected data
angular_velocity_trace = fig.data[0]
angular_velocity_trace.x = time_points
angular_velocity_trace.y = angular_velocities